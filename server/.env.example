# Database
DATABASE_URL=postgres://fieldpulse:fieldpulse@localhost:5432/fieldpulse

# Server
PORT=3001
HOST=0.0.0.0

# LLM — prefer Groq (free tier). Falls back to OpenAI, then rules.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS / client
CLIENT_ORIGIN=http://localhost:5173

# Optional: UI URL shown on API GET /
# PUBLIC_UI_URL=http://localhost:8080

# Location heartbeat (ms). Default 60000. Use 15000 for faster local demos.
LOCATION_TICK_MS=60000
