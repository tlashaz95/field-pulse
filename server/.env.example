# Database
DATABASE_URL=postgres://fieldpulse:fieldpulse@localhost:5432/fieldpulse

# Server
PORT=3001
HOST=0.0.0.0

# LLM — prefer Groq (free tier). Falls back to OpenAI, then rules.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS / client
CLIENT_ORIGIN=http://localhost:5173

# Optional: UI URL shown on API GET /
# PUBLIC_UI_URL=http://localhost:8080

# Location heartbeat (ms). Default 60000. Use 15000 for faster local demos.
LOCATION_TICK_MS=60000

# Kafka (optional). Empty = in-process location bus (Render / no broker).
# Docker Compose API uses kafka:29092. Host-run API uses localhost:9092.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=fieldpulse.locations
# KAFKA_GROUP_ID=fieldpulse-sse-local
