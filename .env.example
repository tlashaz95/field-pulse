# Copy to `.env` in the repo root for Docker Compose (never commit `.env`)

# Recommended free LLM (Groq) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional paid fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Location heartbeat interval for the deployment map (ms)
LOCATION_TICK_MS=60000

# Kafka is started by docker compose (no extra env required for the API container).
# Host-run API: KAFKA_BROKERS=localhost:9092 in server/.env
